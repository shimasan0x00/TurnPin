<?xml version="1.0" encoding="utf-8"?>
<!--
  方向グリッドのボタン。選択中のモードは primary_container で塗り、
  枠線もアクセント色にして「今どれが効いているか」を一目で分かるようにする。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <corners android:radius="@dimen/direction_button_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/track_inactive" />
            <corners android:radius="@dimen/direction_button_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
</selector>
