<?xml version="1.0" encoding="utf-8"?>
<!--
  ライト / ダーク共通のスタイル。色はすべて @color/... 参照なので、
  このファイルを night 用に複製する必要はない。
  ドット付きの名前は暗黙の親解決が働くため、親を持たないものは parent="" を明示する。
-->
<resources>

    <!-- ==== 文字 ============================================================ -->

    <style name="TextAppearance.TurnPin.Headline" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.TurnPin.Tagline" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <style name="TextAppearance.TurnPin.CardTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.TurnPin.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- 状態カードに出す現在のモード名。 -->
    <style name="TextAppearance.TurnPin.Value" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.TurnPin.Warning" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- ==== ウィジェット ==================================================== -->

    <style name="Widget.TurnPin.Card" parent="">
        <item name="android:background">@drawable/card_surface</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!--
      方向グリッドのボタン。framework の Button は minWidth 88dp と
      押下時の elevation アニメーションを持っているので、どちらも打ち消す。
    -->
    <style name="Widget.TurnPin.DirectionButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_direction</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/direction_btn_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.TurnPin.PillButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/direction_btn_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
      通知内のボタン。framework の Button は minWidth 88dp を持っており、
      7 個並べると入りきらないので打ち消す。色は @color/... ではなく
      テーマ属性で解決させ、通知シェードの明暗に追従させる。
    -->
    <style name="Widget.TurnPin.NotificationButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/notif_btn_bg</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- 設定カードのチェックボックス。 -->
    <style name="Widget.TurnPin.CheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
