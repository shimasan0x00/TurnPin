<?xml version="1.0" encoding="utf-8"?>
<!--
  常駐通知の**折りたたみ時**の中身（仕様 §4.3）。

  通知の折りたたみ領域は高さが厳しく制限されており、実機（Fire OS 8）では
  「タイトル行＋ボタン行」の 2 段にするとボタンの下半分が切れた。
  そのため折りたたみ時は 1 行に収める。

  [縦] [縦] [横] [縦逆] [横逆] [自動] [停止]
   ↑ 見出しはモード名だけ。アプリ名は通知ヘッダーが既に出しているうえ、
     「TurnPin: 縦」だと幅が足りず省略記号で切れてしまう。

  「アプリを開く」は通知本体のタップ（setContentIntent）で足りるので、
  ここでは省いて幅をボタンに回している。展開すると
  notification_control_big.xml に切り替わり、[アプリ] も出る。

  文字色にテーマ属性（?android:attr/textColorPrimary）は使わない。実機では
  通知シェードの明暗に追従せず、暗いシェードに黒文字が出たため。
-->
<!--
  lint の ButtonStyle は「横並びのボタンはボーダーレスにせよ」という Material の
  ボタンバー向けガイド。ここは通知内のチップ型コントロールで、塗りつぶしが
  シェード上のコントラストを確保する手段そのものなので当てはまらない。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="ButtonStyle"
    android:paddingStart="12dp"
    android:paddingTop="2dp"
    android:paddingEnd="12dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/notifTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:layout_weight="1.5"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/notif_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/notifPortrait"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/notif_btn_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_portrait"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/notifLandscape"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:background="@drawable/notif_btn_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_landscape"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/notifPortraitReverse"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.3"
        android:background="@drawable/notif_btn_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_portrait_reverse"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/notifLandscapeReverse"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.3"
        android:background="@drawable/notif_btn_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_landscape_reverse"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/notifAuto"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1.3"
        android:background="@drawable/notif_btn_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_auto"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/notifStop"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1.3"
        android:background="@drawable/notif_btn_stop_bg"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:singleLine="true"
        android:stateListAnimator="@null"
        android:text="@string/notif_stop"
        android:textAllCaps="false"
        android:textColor="@color/notif_chip_text"
        android:textSize="12sp" />
</LinearLayout>
