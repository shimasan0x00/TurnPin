<?xml version="1.0" encoding="utf-8"?>
<!--
  常駐通知の中身（仕様 §4.3）。RemoteViews で扱えるのは framework が許可した
  View だけなので、LinearLayout / TextView / Button のみで組む。

  文字色はシェードの明暗に追従させるため ?android:attr/textColorPrimary を使い、
  固定色を焼き込まない。

  [アプリ] [縦] [横] [縦逆] [横逆] [自動] [停止]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/notifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/notifOpen"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="@string/notif_open" />

        <Button
            android:id="@+id/notifPortrait"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notif_portrait" />

        <Button
            android:id="@+id/notifLandscape"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notif_landscape" />

        <Button
            android:id="@+id/notifPortraitReverse"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/notif_portrait_reverse" />

        <Button
            android:id="@+id/notifLandscapeReverse"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/notif_landscape_reverse" />

        <Button
            android:id="@+id/notifAuto"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/notif_auto" />

        <Button
            android:id="@+id/notifStop"
            style="@style/Widget.TurnPin.NotificationButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:layout_weight="1.2"
            android:background="@drawable/notif_btn_stop_bg"
            android:text="@string/notif_stop" />
    </LinearLayout>
</LinearLayout>
