<?xml version="1.0" encoding="utf-8"?>
<!-- 仕様 §11 の既知の制約を短くまとめたもの。README にも同じ内容を載せる。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.TurnPin.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notes_title"
        android:textAppearance="@style/TextAppearance.TurnPin.CardTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/notes_body"
        android:textAppearance="@style/TextAppearance.TurnPin.Caption" />
</LinearLayout>
