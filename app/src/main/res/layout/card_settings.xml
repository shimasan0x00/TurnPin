<?xml version="1.0" encoding="utf-8"?>
<!-- 永続設定（仕様 §4.4）と互換モード（§2.3）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.TurnPin.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textAppearance="@style/TextAppearance.TurnPin.CardTitle" />

    <CheckBox
        android:id="@+id/startOnBootCheck"
        style="@style/Widget.TurnPin.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/setting_start_on_boot" />

    <CheckBox
        android:id="@+id/syncSystemCheck"
        style="@style/Widget.TurnPin.CheckBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setting_sync_system" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:text="@string/setting_sync_system_caption"
        android:textAppearance="@style/TextAppearance.TurnPin.Caption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/setting_compat_title"
        android:textAppearance="@style/TextAppearance.TurnPin.CardTitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/setting_compat_caption"
        android:textAppearance="@style/TextAppearance.TurnPin.Caption" />

    <RadioGroup
        android:id="@+id/compatGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/compatA"
            style="@style/Widget.TurnPin.CompatOption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/compat_a" />

        <RadioButton
            android:id="@+id/compatB"
            style="@style/Widget.TurnPin.CompatOption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/compat_b" />

        <RadioButton
            android:id="@+id/compatC"
            style="@style/Widget.TurnPin.CompatOption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/compat_c" />

        <RadioButton
            android:id="@+id/compatD"
            style="@style/Widget.TurnPin.CompatOption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/compat_d" />
    </RadioGroup>
</LinearLayout>
